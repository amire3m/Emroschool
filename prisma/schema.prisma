generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  emailVerified Boolean @default(true)
  newsletterSubscribed Boolean @default(false)
  notificationEmailEnabled Boolean @default(true)
  notificationSmsEnabled Boolean @default(false)
  notificationBaleEnabled Boolean @default(false)
  name      String
  password  String
  role      String   @default("user")    // superadmin | admin | user
  userType  String   @default("student") // student | instructor | alumni | admin
  phone     String?
  balePhone String?
  nationalCode String? @unique
  phoneVerified Boolean @default(false)
  birthDate String?
  gender    String?
  province  String?
  city      String?
  district  String?
  neighborhood String?
  discoverySource String?
  registrationCompleted Boolean @default(false)
  address   String?
  postalCode String?
  workHistory String?
  artHistory String?
  educationLevel String?
  educationField String?
  university String?
  universityField String?
  instagramId String?
  virtualPhone String?
  landline String?
  avatar    String?
  bio       String?
  expertise String?
  socialLinks String?
  profileVisible Boolean @default(false)
  profileApprovalStatus String @default("pending") // pending | approved | rejected
  profileRejectionReason String?
  profileReviewedAt DateTime?
  profileReviewerId String?
  permissions   String?                  // JSON array for content admins
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments   Enrollment[]
  paymentOrders PaymentOrder[] @relation("PaymentOrderUser")
  reviewedPaymentOrders PaymentOrder[] @relation("PaymentOrderReviewer")
  reviewedProfiles User[] @relation("ProfileReviewer")
  profileReviewer User? @relation("ProfileReviewer", fields: [profileReviewerId], references: [id], onDelete: SetNull)
  createdPaymentOrders PaymentOrder[] @relation("PaymentOrderCreator")
  courseApplications CourseApplication[]
  notifications UserNotification[]
  instructor    Instructor?
  alumni        Alumni?
  avatarSubmissions AvatarSubmission[] @relation("AvatarOwner")
  reviewedAvatarSubmissions AvatarSubmission[] @relation("AvatarReviewer")
  supportTickets SupportTicket[] @relation("SupportTicketOwner")
  supportMessages SupportMessage[] @relation("SupportMessageAuthor")
  auditLogs UserAuditLog[] @relation("UserAuditActor")
}

model UserAuditLog {
  id        String   @id @default(cuid())
  action    String
  fields    String
  createdAt DateTime @default(now())

  targetUserId String
  actorId      String
  actor        User     @relation("UserAuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([targetUserId, createdAt])
}

model SupportTicket {
  id        String   @id @default(cuid())
  number    String   @unique @default(cuid())
  subject   String
  status    String   @default("open") // open | waiting_for_user | waiting_for_support | closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  closedAt  DateTime?

  userId    String
  user      User     @relation("SupportTicketOwner", fields: [userId], references: [id], onDelete: Cascade)
  messages  SupportMessage[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
}

model SupportMessage {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model AvatarSubmission {
  id              String   @id @default(cuid())
  imageUrl        String
  status          String   @default("pending") // pending | approved | rejected | superseded
  rejectionReason String?
  submittedAt     DateTime @default(now())
  reviewedAt      DateTime?
  userId          String
  reviewerId      String?
  user            User     @relation("AvatarOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewer        User?    @relation("AvatarReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([userId, status, submittedAt])
}

model VerificationCode {
  id          String   @id @default(cuid())
  destination String
  channel     String   // email | sms
  codeHash    String
  purpose     String   @default("register")
  expiresAt   DateTime
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([destination, channel, purpose])
}

model Instructor {
  id         String   @id @default(cuid())
  name       String?
  bio        String?
  expertise  String?
  specialties String?
  socialLinks String?
  profileSlug String? @unique
  avatar     String?
  showOnSite Boolean  @default(true)
  archivedAt DateTime?
  archivedUserId String? @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  events EventInstructor[]
  courses Course[]
  courseAssignments CourseInstructor[]
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  courses Course[]
}

model Course {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  price       Int      @default(0)
  oldPrice    Int?
  instructor  String?
  level       String?
  categoryName String?
  thumbnail   String?
  videoUrl    String?
  duration    String?
  rating      Float    @default(0)
  ratingCount Int      @default(0)
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  notifyOnPublish Boolean @default(false)
  notifyChannel  String?  // email | sms | both
  courseType     String   @default("single") // comprehensive | single
  prerequisiteId String?
  scheduleStatus String   @default("upcoming") // upcoming | completed
  startDate      DateTime?
  endDate        DateTime?
  registrationMode String @default("purchase") // purchase | registration
  registrationFormOverride String?
  deliveryModes String @default("in_person") // in_person | virtual, comma-separated
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gallery      Gallery[]
  enrollments  Enrollment[]
  paymentOrders PaymentOrder[]
  images       CourseImage[]
  categoryId   String?
  category     Category?   @relation(fields: [categoryId], references: [id])
  events       EventCourse[]
  notifications Notification[]
  applications  CourseApplication[]
  parentId      String?
  parent        Course?  @relation("CourseHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Course[] @relation("CourseHierarchy")
  prerequisite Course? @relation("CoursePrerequisite", fields: [prerequisiteId], references: [id], onDelete: SetNull)
  unlockedCourses Course[] @relation("CoursePrerequisite")
  instructorId  String?
  instructorProfile Instructor? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  instructors CourseInstructor[]
}

model CourseInstructor {
  courseId     String
  instructorId String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@id([courseId, instructorId])
}

model CourseImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Gallery {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String?
  slug      String?
  description String?
  altText   String?
  seoTitle  String?
  seoDescription String?
  capturedAt DateTime?
  folder    String?
  createdAt DateTime @default(now())

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id        String   @id @default(cuid())
  progress  Int      @default(0)
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model PaymentOrder {
  id                   String   @id @default(cuid())
  orderNumber          String   @unique
  amountTomans         Int
  amountRials          Int
  method               String
  status               String   @default("pending")
  receiptUrl           String?
  balePayload          String?  @unique
  baleChatId           String?
  baleTransactionRef   String?  @unique
  baleInvoiceUrl       String?
  payerBaleId          String?
  payerBaleName        String?
  payerCardEncrypted   String?
  payerCardMasked      String?
  payerBankName        String?
  payerBankSlug        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  receiptSubmittedAt   DateTime?
  reviewedAt           DateTime?
  rejectionReason      String?
  paidAt               DateTime?
  expiresAt            DateTime?
  activeAttemptId      String?

  userId               String
  user                 User     @relation("PaymentOrderUser", fields: [userId], references: [id], onDelete: Cascade)
  courseId             String
  course               Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  applicationId        String?  @unique
  application          CourseApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  reviewerId           String?
  reviewer             User?    @relation("PaymentOrderReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  manualReference      String?
  manualNote           String?
  createdById          String?
  createdBy            User?    @relation("PaymentOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attempts             PaymentAttempt[]

  @@index([userId, createdAt])
  @@index([courseId, status])
}

model PaymentAttempt {
  id                     String   @id @default(cuid())
  sequence               Int
  method                 String
  status                 String
  amountTomans           Int
  amountRials            Int
  balePayload            String?  @unique
  balePaymentId          String?  @unique
  baleTrackingNumber     String?  @unique
  baleReceiptReference   String?
  baleVerificationStatus String   @default("unverified")
  receiptUrl             String?
  rejectionReason        String?
  createdAt              DateTime @default(now())
  expiresAt              DateTime?
  baleInvoiceSentAt      DateTime?
  balePreCheckoutAt      DateTime?
  paidAt                 DateTime?
  submittedAt            DateTime?
  invalidatedAt          DateTime?

  orderId       String
  order         PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, sequence])
  @@index([orderId, status])
}

model PaymentSettings {
  id              Int      @id @default(1)
  cardNumber      String?
  cardHolder      String?
  cardInstructions String?
  adminChatId     String?
  updatedAt       DateTime @updatedAt
}

model CourseApplication {
  id                   String   @id @default(cuid())
  status               String   @default("pending") // pending | approved | rejected
  fullName             String
  email                String
  phone                String
  nationalCode         String?
  birthDate            String?
  gender               String?
  province             String
  city                 String
  district             String?
  neighborhood         String?
  address              String
  postalCode           String
  workHistory          String?
  artHistory           String?
  educationLevel       String
  educationField       String
  university           String?
  universityField      String?
  reason               String
  knowsInstructors     Boolean  @default(false)
  familiarityDetails   String?
  instagramId          String?
  virtualPhone         String
  landline             String?
  discountCode         String?
  discountLabel        String?
  discountPercent      Int      @default(0)
  finalAmountTomans    Int      @default(0)
  discountDocumentUrl  String?
  formSchema           String?
  customResponses      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  paymentOrder PaymentOrder?

  @@unique([userId, courseId])
}

model RegistrationForm {
  id        Int      @id @default(1)
  schema    String
  updatedAt DateTime @updatedAt
}

model DiscountCode {
  id               String   @id @default(cuid())
  code             String   @unique
  label            String
  percent          Int
  active           Boolean  @default(true)
  requiresDocument Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  startDate   DateTime
  endDate     DateTime?
  location    String?
  imageUrl    String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses     EventCourse[]
  instructors EventInstructor[]
}

model EventCourse {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  courseId String
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([eventId, courseId])
}

model EventInstructor {
  id           String     @id @default(cuid())
  eventId      String
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([eventId, instructorId])
}

model Slider {
  id        String   @id @default(cuid())
  title     String?
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  linkText  String?
  order     Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Alumni {
  id           String   @id @default(cuid())
  name         String
  field        String
  batch        String
  quote        String
  imageUrl     String?
  achievements String?
  order        Int      @default(0)
  showOnSite   Boolean  @default(true)
  archivedAt   DateTime?
  archivedUserId String? @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model PageSection {
  id        String   @id @default(cuid())
  slug      String   @unique
  content   String
  order     Int      @default(0)
  visible   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Notification {
  id         String   @id @default(cuid())
  title      String
  message    String
  type       String   @default("in-app")
  channel    String?  // email | sms | in-app | all
  sendToAll  Boolean  @default(false)
  createdAt  DateTime @default(now())
  sentAt     DateTime?

  courseId String?
  course   Course?  @relation(fields: [courseId], references: [id])

  users UserNotification[]
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String
  order     Int      @default(0)
  showOnSite Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id            Int      @id @default(autoincrement())
  siteName      String   @default("آکادمی هنر و رسانه امام روح‌الله (ره)")
  siteLogo      String?
  siteFont      String   @default("foran")
  sidebarColor  String   @default("#03004b")
  sidebarLayout String   @default("default")
  bgColor       String   @default("#fbf8ff")
  bgPattern     String?
  updatedAt     DateTime @updatedAt
}

model NewsPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  coverImage  String?
  category    String   @default("general") // general | course | instructor | alumni
  authorName  String?
  tags        String?
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MagazineSetting {
  id              Int      @id @default(autoincrement())
  title           String   @default("مجله آکادمی امام روح‌الله (ره)")
  description     String   @default("روایت‌هایی از مسیر یادگیری، تجربه اساتید و داستان هنرآموختگان")
  logo            String?
  heroLabel       String   @default("مجله آکادمی امام روح‌الله (ره)")
  heroTitle       String   @default("خبر فقط اتفاق نیست؛")
  heroHighlight   String   @default("روایتی‌ست که می‌ماند.")
  heroDescription String   @default("اینجا از مسیر دوره‌ها، تجربه اساتید و داستان هنرآموختگان می‌نویسیم؛ جایی برای دیدن پشت صحنه رشد.")
  accentColor     String   @default("#ffdeab")
  font            String   @default("foran")
  updatedAt       DateTime @updatedAt
}

model UserNotification {
  id             String       @id @default(cuid())
  read           Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
}
