generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("user")    // superadmin | admin | user
  userType  String   @default("student") // student | instructor | alumni | admin
  phone     String?
  avatar    String?
  bio       String?
  expertise String?
  socialLinks String?
  profileVisible Boolean @default(false)
  permissions   String?                  // JSON array for content admins
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments   Enrollment[]
  notifications UserNotification[]
  instructor    Instructor?
  alumni        Alumni?
}

model Instructor {
  id         String   @id @default(cuid())
  name       String?
  bio        String?
  expertise  String?
  specialties String?
  socialLinks String?
  avatar     String?
  showOnSite Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  events EventInstructor[]
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  courses Course[]
}

model Course {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  price       Int      @default(0)
  oldPrice    Int?
  instructor  String?
  level       String?
  categoryName String?
  thumbnail   String?
  videoUrl    String?
  duration    String?
  rating      Float    @default(0)
  ratingCount Int      @default(0)
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  notifyOnPublish Boolean @default(false)
  notifyChannel  String?  // email | sms | both
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gallery      Gallery[]
  enrollments  Enrollment[]
  images       CourseImage[]
  categoryId   String?
  category     Category?   @relation(fields: [categoryId], references: [id])
  events       EventCourse[]
  notifications Notification[]
}

model CourseImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Gallery {
  id        String   @id @default(cuid())
  imageUrl  String
  altText   String?
  folder    String?
  createdAt DateTime @default(now())

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id        String   @id @default(cuid())
  progress  Int      @default(0)
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  startDate   DateTime
  endDate     DateTime?
  location    String?
  imageUrl    String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses     EventCourse[]
  instructors EventInstructor[]
}

model EventCourse {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  courseId String
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([eventId, courseId])
}

model EventInstructor {
  id           String     @id @default(cuid())
  eventId      String
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([eventId, instructorId])
}

model Slider {
  id        String   @id @default(cuid())
  title     String?
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  linkText  String?
  order     Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Alumni {
  id           String   @id @default(cuid())
  name         String
  field        String
  batch        String
  quote        String
  imageUrl     String?
  achievements String?
  order        Int      @default(0)
  showOnSite   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model PageSection {
  id        String   @id @default(cuid())
  slug      String   @unique
  content   String
  order     Int      @default(0)
  visible   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Notification {
  id         String   @id @default(cuid())
  title      String
  message    String
  type       String   @default("in-app")
  channel    String?  // email | sms | in-app | all
  sendToAll  Boolean  @default(false)
  createdAt  DateTime @default(now())
  sentAt     DateTime?

  courseId String?
  course   Course?  @relation(fields: [courseId], references: [id])

  users UserNotification[]
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String
  order     Int      @default(0)
  showOnSite Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id            Int      @id @default(autoincrement())
  siteName      String   @default("آکادمی هنر و رسانه امام روح‌الله (ره)")
  siteLogo      String?
  siteFont      String   @default("foran")
  sidebarColor  String   @default("#03004b")
  sidebarLayout String   @default("default")
  bgColor       String   @default("#fbf8ff")
  bgPattern     String?
  updatedAt     DateTime @updatedAt
}

model NewsPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  coverImage  String?
  category    String   @default("general") // general | course | instructor | alumni
  authorName  String?
  tags        String?
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MagazineSetting {
  id              Int      @id @default(autoincrement())
  title           String   @default("مجله آکادمی امام روح‌الله (ره)")
  description     String   @default("روایت‌هایی از مسیر یادگیری، تجربه اساتید و داستان هنرآموختگان")
  logo            String?
  heroLabel       String   @default("مجله آکادمی امام روح‌الله (ره)")
  heroTitle       String   @default("خبر فقط اتفاق نیست؛")
  heroHighlight   String   @default("روایتی‌ست که می‌ماند.")
  heroDescription String   @default("اینجا از مسیر دوره‌ها، تجربه اساتید و داستان هنرآموختگان می‌نویسیم؛ جایی برای دیدن پشت صحنه رشد.")
  accentColor     String   @default("#ffdeab")
  font            String   @default("foran")
  updatedAt       DateTime @updatedAt
}

model UserNotification {
  id             String       @id @default(cuid())
  read           Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
}
