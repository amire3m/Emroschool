JWT_SECRET=replace-with-a-long-random-secret
VERIFICATION_SECRET=replace-with-another-long-random-secret
REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="آکادمی امام روح‌الله <no-reply@example.com>"
# For a local Postfix relay use SMTP_HOST=127.0.0.1, SMTP_PORT=25 and leave SMTP_USER/SMTP_PASS empty.
NEXT_PUBLIC_MAIN_SITE_URL=https://imamruhollahschool.com
NEXT_PUBLIC_MAGAZINE_URL=https://mag.imamruhollahschool.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
BALE_BOT_TOKEN=your-bale-bot-token
BALE_WALLET_TOKEN=your-bale-wallet-token
BALE_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
BALE_BOT_USERNAME=imamruhollahschool_bot
# Optional generic notification gateways. Each receives POST JSON: { destination, message }.
SMS_NOTIFICATION_URL=https://provider.example.com/sms
SMS_NOTIFICATION_TOKEN=replace-with-sms-token
BALE_NOTIFICATION_URL=https://provider.example.com/bale
BALE_NOTIFICATION_TOKEN=replace-with-bale-token
